territorial-organizations
addSpanishCaribbean

	^ TCountryOrganization new
		  addName: 'Spanish West Indies';
		  addName: 'Caribe Español';
		  preferredName: 'Spanish Caribbean';
		  formedYear: 1492 dissolvedYear: 1898;
		  beHistorical;
		  populateWith: 'Cuba
Dominican Republic
Puerto Rico';
		  yourself